{
  "name": "@axing/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "author": "Axing Studio",
  "description": "阿星工坊 — 多智能体工作流指挥中心",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -n vite,tsc,elec \"vite\" \"tsc -w -p tsconfig.electron.json\" \"wait-on dist-electron/main.js && electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "build:web": "cd ../web && npm run build",
    "build:api": "cd ../api && node build.js",
    "build:all": "npm run build:api && npm run build:web && npm run build",
    "pack": "npm run build:all && electron-builder --win --config.forceCodeSigning=false",
    "pack:dir": "npm run build:all && electron-builder --win --dir --config.forceCodeSigning=false"
  },
  "dependencies": {
    "@axing/shared": "*",
    "electron-updater": "^6.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "35.2.1",
    "electron-builder": "^26.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.axingstudio.agent-runtime",
    "productName": "阿星工坊",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web-dist",
        "filter": ["**/*"]
      },
      {
        "from": "../api/dist/server.cjs",
        "to": "api/server.cjs"
      },
      {
        "from": "../../node_modules/sql.js",
        "to": "api/node_modules/sql.js",
        "filter": ["**/*", "!dist/*.wasm", "dist/sql-wasm.wasm"]
      }
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "阿星工坊"
    },
    "npmRebuild": false
  }
}
