{
  "name": "axing-studio",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "dev:api": "npm -w apps/api run dev",
    "dev:web": "npm -w apps/web run dev",
    "dev:agent": "npm -w workers/mock-agent run dev",
    "build": "npm -w packages/shared run build && npm -w apps/api run build"
  }
}
